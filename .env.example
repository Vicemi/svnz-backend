# ---------------------------------------------------------------------------------------------
# svnz-backend: copy this file to `.env` and edit it. Nothing else needs to be configured.
# ---------------------------------------------------------------------------------------------

# Where the server listens.
PORT=8787
HOST=0.0.0.0

# Shared secret between this server and the game (frontend variable PUBLIC_SVNZ_BACKEND_TOKEN).
# 16-128 characters of A-Z a-z 0-9 . _ -   Make one with:  npm run token
GAME_TOKEN=change-me-to-a-long-random-token

# Sites allowed to talk to the server, comma separated, no trailing slash. Use * only while developing.
ALLOWED_ORIGINS=https://svnz-portweb.vicemi.dev,http://localhost:4321,http://127.0.0.1:4321

# --- Behind Cloudflare (Tunnel / proxy) ---------------------------------------------------------
# Number of proxies in front of the server (Cloudflare Tunnel running on the same machine = 1).
TRUST_PROXY=1
# true = take the visitor's address from CF-Connecting-IP. Only when ALL traffic comes through Cloudflare.
TRUST_CLOUDFLARE=true

# --- Cloudflare Zero Trust / Access (optional) --------------------------------------------------
# Only if the hostname is protected by an Access policy that browsers can pass. Otherwise leave empty
# (see README: use a Bypass policy for the game paths, the GAME_TOKEN already protects the API).
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
CF_ACCESS_REQUIRED=false

# --- Limits -------------------------------------------------------------------------------------
MAX_ROOMS=200
ROOM_IDLE_MINUTES=30
MAX_COOP_PLAYERS=4
MAX_VS_PLAYERS=8
MAX_CONNECTIONS_PER_IP=8
HTTP_RATE_PER_MINUTE=60
CREATE_ROOM_PER_MINUTE=6
WS_MESSAGES_PER_SECOND=90
WS_MAX_PAYLOAD_BYTES=32768

# --- Cooperative difficulty ---------------------------------------------------------------------
# +6% enemy life per extra player (plus the threat of the chosen characters, see src/game.ts)
DIFFICULTY_PER_PLAYER=0.06
# two players = 1.75x the enemies
ENEMY_COUNT_PER_PLAYER=0.75
# extra boss life per extra player
BOSS_HP_PER_PLAYER=0.5
DIFFICULTY_CAP=2

LOG_LEVEL=info
